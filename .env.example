# API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# fal.ai — provider de génération d'images par défaut (Gemini reste disponible en alternative)
FAL_API_KEY=your_fal_api_key_here

# PostgreSQL Configuration
# Exécution locale (make run) : port exposé côté hôte par la stack racine GatchaApi
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=gatcha_user
POSTGRES_PASSWORD=gatcha_password
POSTGRES_DB=gatcha_db

# MinIO Configuration
# Exécution locale : "minio" n'est résolvable que dans le réseau docker
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET_RAW=raw-assets
MINIO_BUCKET_ASSETS=game-assets
MINIO_PUBLIC_URL=http://localhost:9000

# API Invocation
INVOCATION_API_URL=http://localhost:8080
INVOCATION_API_TIMEOUT=30
INVOCATION_API_MAX_RETRIES=3
INVOCATION_API_RETRY_DELAY=2

# API Authentification (vérification du token porteur des routes admin/génération/import)
# Exécution locale : port exposé côté hôte par la stack racine GatchaApi
AUTH_API_URL=http://localhost:8081
AUTH_API_TIMEOUT=5

# Clé interne optionnelle pour les appels machine-à-machine sans token utilisateur
# (scripts, CI). Vide = désactivée (seul le token Bearer est accepté).
INTERNAL_API_KEY=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
